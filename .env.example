# Local execution is intended for trusted snippets.
APP_ENV=development
HOST=127.0.0.1
PORT=5000
MAX_CODE_LENGTH=20000
EXECUTION_TIMEOUT_SECONDS=5
MAX_TRACE_STEPS=800
MAX_MEMORY_MB=256
MAX_OUTPUT_BYTES=65536
ALLOW_CODE_EXECUTION=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
C_COMPILER=gcc
